{
  "name": "Meta Product Catalogue",
  "description": "Agent-first product catalogue (static preview — write endpoints require the Node server).",
  "version": "1.0",
  "catalog_feed": "https://joseperko1982.github.io/andrej-karpathy-skills/api/catalog.json",
  "llms_txt": "https://joseperko1982.github.io/andrej-karpathy-skills/llms.txt",
